# =============================================================================
# ZakPOS - server environment template
# =============================================================================
# Usage (from the repo root):
#   1. scripts/gen-or-copy-env.sh   -> creates server/.env with a random
#      JWT_SECRET (compose reads server/.env via env_file)
#   2. docker compose up -d --build
#
# The compose stack overrides DATABASE_URL / REDIS_URL / OCR_SERVICE_URL with
# in-container hostnames. The localhost values below are what bare-metal
# development (npm run start:dev in server/) needs. Never commit server/.env.
# =============================================================================
# --- Required: the API refuses to boot without these (fail-fast) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- HTTP server ---
NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:41923,http://localhost:3000,http://localhost:96140
FRONTEND_URL=http://localhost:41923

# --- Database (bare-metal dev; compose injects in-container URLs) ---
DATABASE_URL=postgresql://postgres:postgres123@localhost:47821/zakpos_dev?schema=public?schema=public
DATABASE_APP_URL=postgresql://zakpos_app:zakpos_app_dev_2026@localhost:47821/zakpos_dev

# --- Redis (sessions) ---
REDIS_URL=redis://:redis123@localhost:46392

# --- OCR microservice (services/ocr) ---
OCR_SERVICE_URL=http://localhost:58000
# Shared X-API-Key. Empty = open within the docker network (dev only).
# If you set a value here, give the ocr service the SAME value.
OCR_API_KEY=

# --- Auth0 - OPTIONAL dual-store login (see env.auth0.example) ---
# Leave domain+client id empty for local-only auth. If you configure
# AUTH0_DOMAIN + AUTH0_CLIENT_ID, AUTH0_SECRET becomes REQUIRED - the
# API refuses to boot with a missing session secret (no fallback).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://zakpos.com/api
AUTH0_BASE_URL=https://localhost:39847
AUTH0_SECRET=
AUTH0_CONNECTION=Username-Password-Authentication
# Machine-to-machine client for the Management API (user mirroring):
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# --- Customer platform ---
# OTP delivery for customer login: mock (logs the code) or auth0.
CUSTOMER_OTP_PROVIDER=mock
CUSTOMER_JWT_EXPIRES_IN=7d

# --- Natural-language reports (optional) ---
# Any OpenAI-compatible endpoint. Without a key, the /reports ask box and
# forecasting degrade gracefully to rule-based parsing.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
